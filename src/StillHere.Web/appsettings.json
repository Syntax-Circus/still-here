{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "FilePath": "logs/log-.txt"
  },
  "ConnectionStrings": {
    "Default": "Data Source=stillhere.db"
  },
  "DataProtection": {
    "KeysPath": "keys"
  },
  "Scheduler": {
    "TickIntervalSeconds": 30,
    "AuditLogRetentionTickIntervalSeconds": 86400
  },
  "AllowedHosts": "*"
}
