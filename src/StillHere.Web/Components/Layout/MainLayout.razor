@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <nav class="navbar navbar-expand navbar-dark bg-dark px-3">
            <a class="navbar-brand" href="/">still-here</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" href="/">Dashboard</a>
                <a class="nav-link" href="/audit-log">Audit log</a>
                <a class="nav-link" href="/settings">Settings</a>
            </div>
            <div class="d-flex align-items-center gap-3 top-bar">
                <span class="text-light">Signed in as @context.User.Identity?.Name</span>
                <form method="post" action="/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                </form>
            </div>
        </nav>
    </Authorized>
</AuthorizeView>

<main class="container-fluid py-3">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
