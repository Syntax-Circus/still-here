@page "/domains/add"
@rendermode InteractiveServer

<PageTitle>Add domain - still-here</PageTitle>

<h1>Add domain</h1>

@if (_errorMessages.Count > 0)
{
    <ul class="alert alert-danger form-errors" role="alert">
        @foreach (var message in _errorMessages)
        {
            <li>@message</li>
        }
    </ul>
}

<EditForm Model="_viewModel" OnValidSubmit="HandleSubmitAsync">
    <div class="mb-3">
        <label class="form-label" for="domainName">Domain name</label>
        <InputText id="domainName" class="form-control" @bind-Value="_viewModel.DomainName" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="host">Host</label>
        <InputText id="host" class="form-control" @bind-Value="_viewModel.Host" />
        <p class="form-text field-hint">Use "@@" for the bare domain, a subdomain name, or "*" for a wildcard.</p>
    </div>

    <div class="mb-3">
        <label class="form-label" for="providerKey">DNS provider</label>
        <InputSelect id="providerKey" class="form-select" @bind-Value="_viewModel.ProviderKey" @bind-Value:after="OnProviderChanged">
            @foreach (var provider in _providers)
            {
                <option value="@provider.ProviderKey">@provider.DisplayName</option>
            }
        </InputSelect>
    </div>

    @foreach (var field in _credentialFields)
    {
        @* Plain HTML input, not <InputText>: InputBase<T>'s @bind-Value can't bind a dictionary
           indexer (FieldIdentifier.Create can't parse that expression shape). Native-element @bind
           is pure Razor-compiler sugar and doesn't go through that machinery. *@
        <div class="mb-3">
            <label class="form-label" for="@($"credential-{field.Key}")">@field.Label</label>
            <input id="@($"credential-{field.Key}")" class="form-control" type="@(field.IsSecret ? "password" : "text")"
                   @bind="_viewModel.CredentialSecrets[field.Key]" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label" for="pollingInterval">Polling interval override (seconds, optional)</label>
        <InputNumber id="pollingInterval" class="form-control" @bind-Value="_viewModel.PollingIntervalOverrideSeconds" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">Add domain</button>
    <a class="btn btn-outline-secondary" href="/">Cancel</a>
</EditForm>
