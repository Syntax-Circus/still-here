@page "/setup"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Set up still-here</PageTitle>

<div class="auth-page container" style="max-width: 24rem;">
    <h1>Create the admin account</h1>
    <p class="text-muted">This is a one-time setup step &mdash; still-here supports a single admin account.</p>

    @if (_viewModel.ErrorMessage is not null)
    {
        <p class="alert alert-danger auth-error" role="alert">@_viewModel.ErrorMessage</p>
    }

    <form method="post" action="/setup">
        <AntiforgeryToken />

        <div class="mb-3">
            <label class="form-label" for="username">Username</label>
            <input id="username" name="username" type="text" class="form-control" autocomplete="username" required autofocus />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input id="password" name="password" type="password" class="form-control" autocomplete="new-password" required minlength="8" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="confirmPassword">Confirm password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" autocomplete="new-password" required minlength="8" />
        </div>

        <button type="submit" class="btn btn-primary">Create account</button>
    </form>
</div>
