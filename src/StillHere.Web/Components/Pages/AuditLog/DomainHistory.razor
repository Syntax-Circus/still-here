@page "/domains/{Id:int}/history"
@rendermode InteractiveServer

<PageTitle>@(_domainName is null ? "Domain history" : $"{_domainName} history") - still-here</PageTitle>

@if (_notFound)
{
    <h1>Domain not found</h1>
    <p><a href="/">Back home</a></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>History: @_domainName</h1>
        <a class="btn btn-outline-secondary" href="/">Back to dashboard</a>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (_isLoading)
    {
        <p>Loading…</p>
    }
    else if (_rows.Count == 0)
    {
        <p class="text-muted">No history yet for this domain.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>Event</th>
                        <th>IP change</th>
                        <th>Message</th>
                        <th>Success</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.TimestampUtc.ToString("u")</td>
                            <td>@row.EventType</td>
                            <td>@row.IpDiffDisplay</td>
                            <td>@row.Message</td>
                            <td>@(row.Success ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav aria-label="History pages">
            <ul class="pagination">
                <li class="page-item @(_hasPreviousPage ? "" : "disabled")">
                    <button class="page-link" type="button" disabled="@(!_hasPreviousPage)" @onclick="() => LoadPageAsync(_page - 1)">Previous</button>
                </li>
                <li class="page-item disabled"><span class="page-link">Page @_page of @_totalPages</span></li>
                <li class="page-item @(_hasNextPage ? "" : "disabled")">
                    <button class="page-link" type="button" disabled="@(!_hasNextPage)" @onclick="() => LoadPageAsync(_page + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}
