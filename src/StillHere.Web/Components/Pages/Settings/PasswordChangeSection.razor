<h2>Change password</h2>

@if (_errorMessages.Count > 0)
{
    <ul class="alert alert-danger form-errors" role="alert">
        @foreach (var message in _errorMessages)
        {
            <li>@message</li>
        }
    </ul>
}

@if (_successMessage is not null)
{
    <div class="alert alert-success" role="alert">@_successMessage</div>
}

<EditForm Model="_viewModel" OnValidSubmit="HandleSubmitAsync">
    @* Plain HTML inputs, not <InputText>: InputText hardcodes type="text", which cannot render a
       password field. Native-element @bind is pure Razor-compiler sugar and works fine here. *@
    <div class="mb-3">
        <label class="form-label" for="currentPassword">Current password</label>
        <input id="currentPassword" type="password" class="form-control" @bind="_viewModel.CurrentPassword" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="newPassword">New password</label>
        <input id="newPassword" type="password" class="form-control" @bind="_viewModel.NewPassword" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="confirmNewPassword">Confirm new password</label>
        <input id="confirmNewPassword" type="password" class="form-control" @bind="_viewModel.ConfirmNewPassword" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">Change password</button>
</EditForm>
