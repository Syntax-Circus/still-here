# Copy this file to `.env.local` in this folder for local Development overrides.
# Loaded automatically in Development (see SyntaxCircus.DotEnv in Program.cs); set
# DotEnv__Enabled=true to also load it outside Development.

# Database
# Absolute paths work too, e.g.: ConnectionStrings__Default=Data Source=C:/data/stillhere.db
ConnectionStrings__Default=Data Source=stillhere.db

# Data protection (encryption keys for credentials at rest)
DataProtection__KeysPath=keys

# Scheduler
Scheduler__TickIntervalSeconds=30
Scheduler__AuditLogRetentionTickIntervalSeconds=86400

# Logging
Logging__FilePath=logs/log-.txt
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore=Warning

# Hosting
AllowedHosts=*
