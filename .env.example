# Copy this file to `.env` in this same folder before running:
#   docker compose -f docker-compose.prod.yml up -d
# Docker Compose loads `.env` automatically for ${...} substitution in that file.
# (This is separate from src/StillHere.Web/.env.example, which configures a local
# `dotnet run`/Visual Studio session, not a container.)

# Image tag to deploy. Pin to a specific SemVer (e.g. 0.2.0) for a repeatable,
# rollback-able deployment; `latest` follows the newest main-branch build.
IMAGE_TAG=latest

# Host port the app is published on.
HOST_PORT=8080

# Comma-separated list of hostnames this app will accept requests for.
# Leave as * to accept any Host header -- fine behind a trusted reverse proxy
# that already validates the request's origin.
ALLOWED_HOSTS=*

# How often (in seconds) each domain's DNS check runs, and how often expired
# audit log entries are pruned. Defaults match the application's own built-in
# defaults -- override only if you want a different cadence.
SCHEDULER_TICK_INTERVAL_SECONDS=30
SCHEDULER_AUDIT_LOG_RETENTION_TICK_INTERVAL_SECONDS=86400
