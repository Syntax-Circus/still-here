<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- CA1861: fires on EF Core's auto-generated migration seed-data arrays (HasData), which are never hand-edited -->
    <!-- CA1707: underscore-separated test method names (e.g. MethodName_Scenario_ExpectedResult) are the intended convention here -->
    <NoWarn>$(NoWarn);CA1861;CA1707</NoWarn>
  </PropertyGroup>
</Project>
